{
  "name": "@contentual/api",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "build:deps": "yarn workspace @contentual/content-engine-vocabulary build && yarn workspace @contentual/programme-matching-vocabulary build",
    "build": "yarn build:deps && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "yarn build:deps && nest start",
    "start:dev": "yarn build:deps && nest start --watch",
    "start:dev:https": "API_PUBLIC_URL=https://localhost:3000/api-proxy WEB_ORIGIN=https://localhost:3000 BETTER_AUTH_TRUSTED_ORIGINS=https://localhost:3000 yarn start:dev",
    "test": "yarn build:deps && node --require ts-node/register --test src/**/*.test.ts",
    "test:integration": "yarn build:deps && node --require ts-node/register --test --test-concurrency=1 src/**/*.integration.test.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "yarn typeorm migration:generate -d src/database/data-source.ts",
    "migration:run": "yarn typeorm migration:run -d src/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "yarn typeorm migration:revert -d src/database/data-source.ts",
    "reset:test-user": "node --require ts-node/register src/scripts/reset-test-user.ts",
    "instagram:pull": "yarn build:deps && node --require ts-node/register/transpile-only src/scripts/instagram-pull.ts",
    "admin:account": "node --require ts-node/register/transpile-only src/scripts/admin-account.ts",
    "admin:account:prod": "node dist/scripts/admin-account.js",
    "reset:challenge": "node --require ts-node/register src/scripts/reset-challenge.ts",
    "replay:pending": "node dist/scripts/replay-pending-events.js",
    "backfill:rule": "node dist/scripts/backfill-rule.js",
    "backfill:worker": "node dist/scripts/backfill-rule.js --worker",
    "demo:firing-ledger": "yarn build:deps && node --require ts-node/register src/scripts/demo-firing-ledger.ts",
    "demo:programme-event": "yarn build:deps && node --require ts-node/register src/scripts/demo-programme-event.ts",
    "demo:task-event": "yarn build:deps && node --require ts-node/register src/scripts/demo-task-event.ts",
    "demo:instagram-event": "yarn build:deps && node --require ts-node/register src/scripts/demo-instagram-event.ts",
    "demo:in-app-notification": "yarn build:deps && node --require ts-node/register src/scripts/demo-in-app-notification.ts",
    "demo:posthog": "yarn build:deps && node --require ts-node/register src/scripts/demo-posthog.ts",
    "replay:pending:dev": "yarn build:deps && node --require ts-node/register/transpile-only src/scripts/replay-pending-events.ts",
    "backfill:rule:dev": "yarn build:deps && node --require ts-node/register/transpile-only src/scripts/backfill-rule.ts",
    "backfill:worker:dev": "yarn build:deps && node --require ts-node/register/transpile-only src/scripts/backfill-rule.ts --worker",
    "verify:matching": "yarn build:deps && node --require ts-node/register src/scripts/verify-published-programme-matching.ts",
    "stripe:bootstrap": "node --require ts-node/register/transpile-only src/scripts/stripe-bootstrap.ts",
    "billing:founding": "node --require ts-node/register/transpile-only src/scripts/founding-status.ts",
    "billing:reconcile": "yarn build:deps && node --require ts-node/register/transpile-only src/scripts/billing-reconcile.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@contentual/content-engine-vocabulary": "workspace:*",
    "@contentual/programme-matching-vocabulary": "workspace:*",
    "@nestjs/common": "latest",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/typeorm": "^11.0.3",
    "better-auth": "^1.6.23",
    "mime-types": "^3.0.2",
    "pg": "^8.22.0",
    "posthog-node": "^5.46.1",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "stripe": "^22.6.2",
    "typeorm": "^0.3.28",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/mime-types": "^3",
    "@types/node": "^26.1.0",
    "@types/pg": "^8",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "prettier": "latest",
    "source-map-support": "latest",
    "ts-node": "latest",
    "tsconfig-paths": "latest",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.63.0"
  }
}
