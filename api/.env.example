PORT=3001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contentual
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# Matching cutover: shadow evaluates the CMS snapshot and records redacted
# mismatches while the released First Take decision remains authoritative.
# Switch to `published` only after the shadow window is reviewed; use `legacy`
# for an emergency rollback.
PROGRAMME_MATCHING_ROLLOUT=shadow
# Dedicated rematch credential and the server-owned identity recorded in its
# audit trail. Clients cannot override this actor with a request header.
PROGRAMME_MATCHING_ADMIN_TOKEN=
PROGRAMME_MATCHING_ADMIN_ACTOR=

BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001
# Public url the browser reaches this api on. Deployed, that is the web
# origin's proxy path (https://<web-host>/api-proxy), not the api host — the
# session cookie has to be first-party to the web app. Leave unset locally;
# BETTER_AUTH_URL is used as the fallback. The Google redirect uri is always
# `${API_PUBLIC_URL}/api/auth/callback/google`.
# API_PUBLIC_URL=https://<web-host>/api-proxy
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUTH_EMAIL_OTP_EXPIRES_SECONDS=300
AUTH_EMAIL_OTP_ALLOWED_ATTEMPTS=3
AUTH_EMAIL_OTP_RESEND_WINDOW_SECONDS=60
AUTH_EMAIL_OTP_RESEND_MAX=3

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth redirect URI for local development:
# http://localhost:3001/api/auth/callback/google

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_CDN_BASE_URL=https://cdn.example.com
AVATAR_MAX_BYTES=5242880

RESEND_API_KEY=
RESEND_FROM_EMAIL=Contentual <login@example.com>
RESEND_REPLY_TO_EMAIL=

# Product analytics and error tracking. One shared client covers both, plus
# Content Engine rule-evaluation observability. An empty key disables capture
# without disabling anything it observes.
#
# The host must stay in the EU region — this is the same PostHog project the web
# app reports into via NEXT_PUBLIC_POSTHOG_KEY.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Instagram integration (Meta Graph API, "Instagram API with Instagram Login").
# All three of app id, app secret and encryption key are required together —
# with any of them missing the module binds its stubs instead, which is the
# supported way to run locally and in CI without a Meta app.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Every stored token records
# the key id it was sealed with, so rotating means adding a key, not losing the
# tokens sealed under the old one.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_TOKEN_KEY_ID=v1
# Redirect uri to register in the Meta app dashboard. Derived, not configured —
# it is always `${API_PUBLIC_URL}/instagram/oauth/callback`, which deployed is
# the web origin's proxy path, exactly as the Google callback is. Meta requires
# https, so testing the real flow locally means a tunnel:
#   cloudflared tunnel --url http://localhost:3000
#   API_PUBLIC_URL=https://<tunnel>/api-proxy  WEB_ORIGIN=https://<tunnel>
INSTAGRAM_HTTP_TIMEOUT_MS=10000
INSTAGRAM_OAUTH_STATE_TTL_MS=600000
# How long we promise to take to erase a user's Instagram data, in the privacy
# policy, the disconnect warning, and the Meta deletion callback alike.
INSTAGRAM_DELETION_SLA_DAYS=7
# Meta app dashboard callbacks (both verify the signed_request with the app secret):
#   Deauthorize callback URL:   ${API_PUBLIC_URL}/instagram/deauthorize
#   Data deletion callback URL: ${API_PUBLIC_URL}/instagram/data-deletion

# The timezone sweep dispatcher, which serves every per-user daily job — the
# Instagram pull today, the 7am notification next. Off by default: it makes
# outbound calls on a timer, which is not something a developer should get by
# running the app.
# Runs the per-user 7am sweep. The Instagram daily pull registers on it, and
# that pull is what refreshes long-lived tokens — left false in production,
# every connection dies when its 60-day token expires.
DAILY_LOCAL_SWEEP_ENABLED=false
DAILY_LOCAL_SWEEP_POLL_MS=60000
# The hour, in each user's own timezone, at which their daily work is served.
# 0-23; anything else falls back to 7.
DAILY_LOCAL_SWEEP_HOUR=7

# Releases queued badge celebrations, at most one per user per 24 hours. On by
# default; it only touches the app database.
BADGE_COOLDOWN_WORKER_ENABLED=true
BADGE_COOLDOWN_POLL_MS=60000

# Billing. Every value is optional: with none of it set the tiers still resolve
# and Stripe is reported unconfigured, so local dev and the test suites run
# without credentials.
#
# No price *amount* appears in code or here — only the id of a Stripe price.
# The live amount is whatever Stripe reports for that id, so a reprice is a
# change in Stripe plus a variable here, never a deploy.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe price each paid tier checks out against. Free has none by design.
# Checkout stays disabled for a tier whose price is unset, and a paid tier with
# no price is left off the pricing table entirely (Pro is hidden until priced).
# `yarn workspace @contentual/api stripe:bootstrap` provisions test-mode
# products, prices and the alpha coupon and prints these four variables.
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=

# Register `https://<api-host>/billing/stripe/webhook` in the Stripe dashboard
# (the api host directly, not the web proxy) for: checkout.session.completed,
# customer.subscription.created / updated / deleted, invoice.paid, customer.deleted. Locally,
# `yarn workspace @contentual/api billing:reconcile -- --email <address>` pulls
# a subscription from Stripe through the same path when no webhook can reach
# this machine.

# The founding-creator lock: a rate held for the first cohort. The lock is a
# separate Stripe price on the Creator product; the cap is enforced at
# purchase time and the offer is presented only while a seat remains.
BILLING_FOUNDING_OFFER_ENABLED=true
BILLING_FOUNDING_COHORT_CAP=200
STRIPE_PRICE_CREATOR_FOUNDING=

# Alpha testers converting to a paid plan: 3 months at 50% off, applied through
# a Stripe coupon or promotion code at Checkout. Without the identifier the
# offer reports disabled however the toggle reads — advertising a discount that
# cannot be applied would charge full price after showing half.
BILLING_ALPHA_OFFER_ENABLED=true
BILLING_ALPHA_DISCOUNT_PERCENT=50
BILLING_ALPHA_DISCOUNT_MONTHS=3
STRIPE_ALPHA_COUPON_ID=

# Referrals: a referred member's first paid month earns the referrer one month
# of their own plan price as a credit on their Stripe customer balance (existing
# discounts are untouched). Links are `${BILLING_REFERRAL_LINK_BASE}/<code>`,
# default `${WEB_ORIGIN}/r`.
BILLING_REFERRAL_ENABLED=true
# BILLING_REFERRAL_LINK_BASE=https://contentual.ai/r

# Where Checkout and the customer portal return the browser to, on WEB_ORIGIN.
# BILLING_RETURN_PATH=/settings/account
# A specific customer-portal configuration; unset uses the account default,
# which is where plan switching and cancel-at-period-end are configured.
# STRIPE_PORTAL_CONFIGURATION_ID=
