# Api origin the browser talks to. Locally this is the api directly — both dev
# servers are on `localhost`, so the session cookie is already same-site.
# Deployed, where web and api sit on different hosts, this must be a path on
# the web origin so the cookie stays first-party:
#   NEXT_PUBLIC_API_URL=https://<web-host>/api-proxy
NEXT_PUBLIC_API_URL=http://localhost:3001

# Where /api-proxy/* is rewritten to (see next.config.ts), and the origin
# Server Components call directly. Leave unset locally.
# API_ORIGIN=https://<api-host>

# Must match the api's BETTER_AUTH_SECRET exactly — used to verify the
# signed session cookie cache in src/proxy.ts without a network call.
BETTER_AUTH_SECRET=

# PostHog project API key and host, used by both the browser and this app's
# server-side capture. NEXT_PUBLIC_ is correct: the project key is a
# publishable, write-only ingestion credential and the browser cannot report
# without it. Never put a personal or secret PostHog key in a NEXT_PUBLIC_ var.
#
# The host must stay in the EU region, and must be the same project the api
# reports into via POSTHOG_API_KEY. An empty key disables capture entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Upstash Redis REST credentials for named rate limiters (auth, mutations,
# analytics refresh). Server-only — never prefix these with NEXT_PUBLIC_.
# Leave empty locally; an absent pair disables limiting rather than failing
# the app, the same way an empty PostHog key disables capture.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
