{
  "name": "@contentual/cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "dev": "next dev -p ${PORT:-3002}",
    "build:deps": "yarn workspace @contentual/content-engine-vocabulary build && yarn workspace @contentual/programme-matching-vocabulary build",
    "build": "yarn build:deps && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "payload": "payload",
    "generate:importmap": "cross-env PAYLOAD_SCHEMA_COMMAND=true payload generate:importmap",
    "generate:types": "cross-env PAYLOAD_SCHEMA_COMMAND=true payload generate:types",
    "migrate": "cross-env PAYLOAD_SCHEMA_COMMAND=true payload migrate",
    "backfill:first-take": "node --import tsx src/seed/backfill-first-take-v1.1.ts",
    "migrate:create": "cross-env PAYLOAD_SCHEMA_COMMAND=true payload migrate:create",
    "seed:first-take": "node --import tsx src/seed/run-first-take-v1.1.ts",
    "test": "node --import tsx --test --test-concurrency=1 src/**/*.test.ts",
    "seed:first-take-matching": "node --import tsx src/seed/run-first-take-matching-v1.ts",
    "seed:programme-catalogue:local": "cross-env ALLOW_LOCAL_DEMO_SEED=true node --env-file-if-exists=.env.local --import tsx src/seed/run-programme-catalogue-v1.ts"
  },
  "dependencies": {
    "@contentual/content-engine-vocabulary": "workspace:*",
    "@contentual/programme-matching-vocabulary": "workspace:*",
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "^2.0.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.11.0",
    "next": "16.3.0",
    "payload": "3.86.0",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass": "^1.96.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
