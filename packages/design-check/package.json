{
  "name": "@contentual/design-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "node --import tsx src/cli.ts",
    "report": "node --import tsx src/cli.ts --html",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "visual": "playwright test -c visual/playwright.config.ts",
    "visual:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "postcss": "^8.5.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
